<Window x:Class="SherpaAxis.App.GameBindingDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SherpaAxis.App.Localization"
        Title="{loc:Text T44AAA42FE836}" Width="700" Height="740" MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dashboard.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GameTile" TargetType="CheckBox">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="108" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CanvasBrush}" CornerRadius="6" Width="48" Height="48" VerticalAlignment="Center">
                                        <Image x:Name="GameIcon" Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock x:Name="NotSelected" Text="{loc:Translate Value={Binding AvailabilityStatus}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="Selected" Text="{loc:Translate Value={Binding SelectionStatus}}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12" Margin="0,7,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                        <Button x:Name="ReassignButton" Content="{loc:Text TA736776CD1E4}" Click="ReassignGameClick" HorizontalAlignment="Stretch"
                                                FontSize="12" Padding="9,5" Margin="0,10,0,0" Visibility="Collapsed">
                                            <Button.ContentTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </StackPanel>
                                    <Border x:Name="CheckSurface" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                            BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" VerticalAlignment="Top">
                                        <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextBrush}" Visibility="Collapsed" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                    <Setter TargetName="ReassignButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="NotSelected" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ReassignButton" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentForegroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Tile" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="DialogRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="24,22,24,18" Background="{DynamicResource WorkspaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel>
                <TextBlock Text="{loc:Text T44AAA42FE836}" FontSize="22" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{loc:Text T468998B19C63}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ProfileLabel" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="{loc:Text TD6C99D4394FF}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                <UniformGrid x:Name="PresetGames" Columns="2" Margin="0,0,-12,4" />
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button Content="{loc:Text TEA4A8E2F8806}" Click="BrowseGameClick" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,7" FontSize="12" />
                            <TextBlock Text="{loc:Text TA38ABCDB86DB}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="AdditionalGames" />
                        <TextBlock x:Name="EmptyGamesHint" Text="{loc:Text T95B409DA11D6}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                        <Expander x:Name="ExecutableNames" Header="{loc:Text T06EC31D8882C}" Margin="0,14,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{loc:Text T6FE4A2FBC305}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBox x:Name="CustomExecutables" AcceptsReturn="True" VerticalContentAlignment="Top" Height="85" MaxLength="6000" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="{loc:Text TCEAB14F3E3EA}" TextChanged="CustomGamesChanged" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Text TEEB68D287137}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0" />
                <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ProblemBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource WorkspaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="24,16">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="16,0,0,0">
                    <Button x:Name="SaveButton" Content="{loc:Text T1509F561F241}" IsDefault="True" Click="SaveClick" Style="{StaticResource Primary}" MinWidth="96" Margin="0,0,8,0" />
                    <Button Content="{loc:Text T19766ED6CCB2}" IsCancel="True" MinWidth="96" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="SelectionSummary" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
