<Window x:Class="SherpaAxis.App.FilteringHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SherpaAxis.App.Models"
        Title="Filtering guide" Width="720" Height="730" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#0B1220" Foreground="#E8EFF8" FontFamily="Segoe UI">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="How filtering changes pedal feel" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Choose less smoothing for a more direct response; more smoothing trades response speed for steadier readings." FontSize="13" Foreground="#95A9C1" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="24,9"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <ItemsControl ItemsSource="{x:Static models:FilteringGuide.Algorithms}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="#111E30" BorderBrush="#304157" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="#78E3C6" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding WhatItDoes}" TextWrapping="Wrap" FontSize="13" Margin="0,7,0,0"/>
                                <TextBlock Text="{Binding DrivingFeel}" TextWrapping="Wrap" Foreground="#B4C4D8" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Static models:FilteringGuide.Summary}" TextWrapping="Wrap" Foreground="#DFBC7A" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
