<Window x:Class="SherpaAxis.App.FilteringHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SherpaAxis.App.Localization"
        xmlns:models="clr-namespace:SherpaAxis.App.Models"
        xmlns:controls="clr-namespace:SherpaAxis.App.Controls"
        Title="{loc:Text T3A0778066A9A}" Width="1440" Height="730" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{loc:Text TA0DCA6552B8F}" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Text T871243C44393}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="{loc:Translate Value={Binding Source={x:Static models:FilteringGuide.ExampleSource}}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="{loc:Text T7D9EB7ACB13E}" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="24,9"/>
        <controls:GuideScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <ItemsControl ItemsSource="{x:Static models:FilteringGuide.Algorithms}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Value={Binding Name}}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Translate Value={Binding WhatItDoes}}" TextWrapping="Wrap" FontSize="13" Margin="0,7,0,0"/>
                                <TextBlock Text="{loc:Translate Value={Binding DrivingFeel}}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,6,0,0"/>
                                <Expander Header="{loc:Text T8B52586A1257}" Margin="0,12,0,0" FontSize="12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Text T9B38805ABFE8}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Examples}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveExamplesPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <StackPanel Margin="0,0,0,14">
                                                    <TextBlock Text="{loc:Translate Value={Binding Title}}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                                    <Button Click="OpenExampleClick" Padding="0" Margin="0" Background="Transparent" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{loc:Translate Value={Binding FullTitle}}">
                                                        <controls:ZoomableImage Source="{loc:Translate Value={Binding ImagePath}, ImagePath=True}" AutomationProperties.Name="{loc:Translate Value={Binding FullTitle}}"/>
                                                    </Button>
                                                    <TextBlock Text="{loc:Translate Value={Binding Caption}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Translate Value={Binding Source={x:Static models:FilteringGuide.Summary}}}" TextWrapping="Wrap" Foreground="{DynamicResource CautionBrush}" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
        </controls:GuideScrollViewer>
    </DockPanel>
</Window>
