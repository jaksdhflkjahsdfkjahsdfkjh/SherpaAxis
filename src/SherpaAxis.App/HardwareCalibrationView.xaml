<UserControl x:Class="SherpaAxis.App.HardwareCalibrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SherpaAxis.App.Localization"
        xmlns:vm="clr-namespace:SherpaAxis.App.ViewModels"
        xmlns:controls="clr-namespace:SherpaAxis.App.Controls"
        Background="#0B1220" Foreground="#E8EFF8" FontFamily="Segoe UI">
    <Border Background="#111D2E">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{loc:Text T9954A7A58B01}" TextWrapping="Wrap" FontSize="11" Foreground="#B4C4D8" Margin="0,0,0,8"/>
                <controls:StableComboBox ItemsSource="{x:Static vm:HardwarePedalViewModel.Channels}" SelectedItem="{Binding SelectedChannel}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{loc:Text T28AB255AD0C3}" ToolTip="{loc:Text T0E59F286C4FD}"/>
                <WrapPanel Margin="0,10,0,8">
                    <Button x:Name="CaptureButton" Content="{loc:Translate Value={Binding CaptureButtonText}}" Click="CaptureClick" IsEnabled="{Binding CanCapture}" FontSize="12" Padding="10,8" MinHeight="36" ToolTip="{loc:Text T0612986A90B7}"/>
                    <Button Content="{loc:Text T412D106BC946}" Click="CancelCaptureClick" IsEnabled="{Binding CanSetMargins}" FontSize="12" Padding="10,8" MinHeight="36" Margin="0" ToolTip="{loc:Text TD4CB5C1B919D}"/>
                </WrapPanel>
                <TextBlock Text="{loc:Translate Value={Binding RangeInfo}}" Foreground="#78E3C6" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="{loc:Translate Value={Binding Status}}" Foreground="#DFBC7A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="{loc:Text TEAF8BD57187E}" Click="SaveClick" IsEnabled="{Binding CanSave}" FontSize="12" Padding="10,8" ToolTip="{loc:Text TF7F06AE8A1CD}"/>
                    <Button Content="{loc:Text TBD82D4F7BA04}" Click="RestoreClick" IsEnabled="{Binding CanRestore}" FontSize="12" Padding="10,8" Margin="0" ToolTip="{loc:Text TD4E524408B9B}"/>
                </WrapPanel>
                <Button Content="{loc:Text T124299E85D3E}" Click="AbandonClick" IsEnabled="{Binding CanAbandon}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="{loc:Text T63ADF3453394}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{loc:Text T2EACD28AF24A}" FontSize="11" TextWrapping="Wrap" Foreground="#B4C4D8" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:Text T57A61CA37178}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid IsEnabled="{Binding CanSetMargins}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:Text TCF1AF5507C1B}" Foreground="#95A9C1" FontSize="11"/><TextBox Text="{Binding LowerDeadzone, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text TAC07DB9AB443}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{loc:Text TD4CEEBB0C59C}" Foreground="#95A9C1" FontSize="11"/><TextBox Text="{Binding UpperDeadzone, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T36D950B42D9C}"/></StackPanel>
                    </Grid>
                    <Expander Header="{loc:Text T757177F1FFA4}" IsEnabled="{Binding CanSelect}"><StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:Text T735BEEE2E390}" Foreground="#95A9C1"/><TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text TC52FD3510A6C}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:Text T66C9AB177708}" Foreground="#95A9C1"/><TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T18D7A6D9671C}"/></StackPanel>
                        </Grid>
                        <Button Content="{loc:Text T0A59012E0482}" Click="ApplyBoundsClick" Margin="0,8,0,0" FontSize="11" HorizontalAlignment="Left"/>
                    </StackPanel></Expander>
                    <Expander Header="{loc:Text TBE2F8120E4D9}"><StackPanel><TextBlock Text="{loc:Translate Value={Binding IdentityInfo}}" Foreground="#95A9C1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="{loc:Translate Value={Binding DeviceInfo}}" Foreground="#B4C4D8" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander>
                    <Expander Header="{loc:Text T657C06283294}"><StackPanel>
                        <Button Content="{loc:Text TF7E56D39B89B}" Click="DefaultsClick" IsEnabled="{Binding CanSelect}" Style="{DynamicResource DeviceToolButton}" ToolTip="{loc:Text TFFEE999F6DB6}"/>
                        <Button x:Name="BackupHardwareButton" Content="{loc:Text TC93E0C467C96}" Click="BackupHardwareClick" IsEnabled="{Binding CanBackup}" Style="{DynamicResource DeviceToolButton}" ToolTip="{loc:Text TAFFBE978927F}"/>
                        <Button x:Name="RestoreHardwareBackupButton" Content="{loc:Text T7159B158EA68}" Click="RestoreBackupClick" IsEnabled="{Binding CanRestore}" Style="{DynamicResource DeviceToolButton}" Margin="0" ToolTip="{loc:Text TF71BD364759B}"/>
                    </StackPanel></Expander>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
