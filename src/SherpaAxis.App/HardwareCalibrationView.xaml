<UserControl x:Class="SherpaAxis.App.HardwareCalibrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SherpaAxis.App.Localization" xmlns:vm="clr-namespace:SherpaAxis.App.ViewModels" xmlns:controls="clr-namespace:SherpaAxis.App.Controls" Background="#0B1220" Foreground="#E8EFF8" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Workspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#111D2E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <GroupBox x:Name="CalibrationCaptureGroup" Header="{loc:Text TD51028ECDB5C}" Tag="">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionNote}" Text="{loc:Text TDEEFC64E891A}" />
                            <TextBlock Style="{StaticResource SectionNote}" Text="{loc:Text TD04AD4B9C1FE}" />
                            <controls:StableComboBox ItemsSource="{x:Static vm:HardwarePedalViewModel.Channels}" SelectedItem="{Binding SelectedChannel}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{loc:Text T28AB255AD0C3}" ToolTip="{loc:Text T0E59F286C4FD}" />
                            <UniformGrid Margin="0,12,0,0" Columns="2">
                                <Button x:Name="CaptureButton" Content="{loc:Translate Value={Binding CaptureButtonText}}" Click="CaptureClick" IsEnabled="{Binding CanCapture}" FontSize="12" Padding="10,8" MinHeight="36" ToolTip="{loc:Text TE6459F53F543}" Style="{DynamicResource Primary}" Margin="0,0,6,0" HorizontalContentAlignment="Center" />
                                <Button Content="{loc:Text TC0F6037104C5}" Click="CancelCaptureClick" IsEnabled="{Binding CanSetMargins}" FontSize="12" Padding="10,8" MinHeight="36" Margin="6,0,0,0" ToolTip="{loc:Text TD4CB5C1B919D}" x:Name="CancelCaptureButton" />
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="CalibrationRangeGroup" Header="{loc:Text TD4BF70AD6CAD}" Tag="">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionNote}" Text="{loc:Text TB2F14BA0CC6D}" />
                            <Grid IsEnabled="{Binding CanEditMargins}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Text TCF1AF5507C1B}" Foreground="#95A9C1" FontSize="11" />
                                    <TextBox Text="{Binding LowerDeadzone, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T526D871D7AC2}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Text TD4CEEBB0C59C}" Foreground="#95A9C1" FontSize="11" />
                                    <TextBox Text="{Binding UpperDeadzone, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text TD8093198234C}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{loc:Translate Value={Binding RangeInfo}}" Foreground="#78E3C6" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <Expander Header="{loc:Text T757177F1FFA4}" IsEnabled="{Binding CanSelect}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Text T735BEEE2E390}" Foreground="#95A9C1" />
                                            <TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text TC52FD3510A6C}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Text T66C9AB177708}" Foreground="#95A9C1" />
                                            <TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T18D7A6D9671C}" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="{loc:Text T0A59012E0482}" Click="ApplyBoundsClick" Margin="0,8,0,0" FontSize="11" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="CalibrationToolsGroup" Header="{loc:Text T0D77E275EA8B}" Tag="">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionNote}" Text="{loc:Text TABEF09AA12CF}" />
                            <Expander Header="{loc:Text T657C06283294}">
                                <StackPanel>
                                    <Button Content="{loc:Text TE81A0AD5F059}" Click="DefaultsClick" IsEnabled="{Binding CanSelect}" Style="{DynamicResource DeviceToolButton}" ToolTip="{loc:Text TB46A8CE8EBE0}" />
                                    <Button x:Name="BackupHardwareButton" Content="{loc:Text T37AD2E2B4214}" Click="BackupHardwareClick" IsEnabled="{Binding CanBackup}" Style="{DynamicResource DeviceToolButton}" ToolTip="{loc:Text TAFFBE978927F}" />
                                    <Button x:Name="RestoreHardwareBackupButton" Content="{loc:Text TBE2126C42895}" Click="RestoreBackupClick" IsEnabled="{Binding CanRestore}" Style="{DynamicResource DeviceToolButton}" Margin="0" ToolTip="{loc:Text TCDA7E23CA4AE}" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{loc:Text TBE2F8120E4D9}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Value={Binding IdentityInfo}}" Foreground="#95A9C1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="{loc:Translate Value={Binding DeviceInfo}}" Foreground="#B4C4D8" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1">
                <GroupBox x:Name="CalibrationSaveGroup" Header="{loc:Text TE702BE959DE4}" Tag="" Margin="0,10,0,0">
                    <GroupBox.Style>
                        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSession}" Value="True" />
                                        <Condition Binding="{Binding IsCapturing}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GroupBox.Style>
                    <StackPanel>
                        <TextBlock x:Name="CalibrationSaveState" Style="{StaticResource SectionNote}" Text="{loc:Translate Value={Binding SaveState}}" />
                        <UniformGrid Columns="2">
                            <Button Content="{loc:Text T2E2D70A29871}" Click="SaveClick" IsEnabled="{Binding CanSave}" FontSize="12" Padding="10,8" ToolTip="{loc:Text TF7F06AE8A1CD}" x:Name="SaveControllerCalibrationButton" Style="{DynamicResource Primary}" Margin="0,0,6,0" HorizontalContentAlignment="Center" />
                            <Button Content="{loc:Text TF9BFA3DC7C8F}" Click="RestoreClick" IsEnabled="{Binding CanRestore}" FontSize="12" Padding="10,8" Margin="6,0,0,0" ToolTip="{loc:Text TD4E524408B9B}" x:Name="DiscardControllerCalibrationButton" HorizontalContentAlignment="Center" />
                        </UniformGrid>
                        <Button Content="{loc:Text T124299E85D3E}" Click="AbandonClick" IsEnabled="{Binding CanAbandon}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="{loc:Text T63ADF3453394}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="{loc:Translate Value={Binding Status}}" Foreground="#DFBC7A" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>