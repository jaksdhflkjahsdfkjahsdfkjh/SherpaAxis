                                                        <Button x:Name="UpdateFirmwareButton" Content="{loc:Text T2D59B6CF3962}" Click="OpenFirmwareUpdateClick" IsEnabled="{Binding CanOpenUpdater}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                                        <Button Content="{loc:Text TB670E016B743}" Click="OpenFirmwareLogClick" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                                        <Button x:Name="BackupFirmwareCalibrationButton" Content="{loc:Text T05A1021A4730}" Click="BackupFirmwareCalibrationClick" IsEnabled="{Binding CanPrepare}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                                        <TextBlock Text="{loc:Translate Value={Binding Status}}" TextWrapping="Wrap" Foreground="#FFCE83" FontSize="11" AutomationProperties.LiveSetting="Polite" />
