                            <Button x:Name="ProfileMoreButton" Content="···" Click="ProfileMenuClick" Width="34" Padding="7" Margin="0" AutomationProperties.Name="{loc:Text TD8C8A6B2F159}" ToolTip="{loc:Text T36204B38D7A0}">
                                <Button.ContextMenu>
                                    <ContextMenu Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
