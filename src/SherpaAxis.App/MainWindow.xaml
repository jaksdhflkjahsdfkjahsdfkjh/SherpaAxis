                                                </Expander>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Tag="updates release GitHub check automatic оновлення версія" Header="{loc:Text T5808DEAECD58}" x:Name="UpdateSettingsGroup">
