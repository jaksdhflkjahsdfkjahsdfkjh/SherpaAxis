                                                    <Expander IsExpanded="{Binding HasIssues, Mode=OneWay}" Header="{loc:Text T51BFFFBCDBCF}" x:Name="ConnectionDetailsExpander">
                                                        <StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Checks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,12">
                                                                            <TextBlock Text="{loc:Translate Value={Binding Title}}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{loc:Translate Value={Binding Detail}}" TextWrapping="Wrap" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="11" Margin="0,4,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="#95A9C1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#FFCE83" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander x:Name="SetupToolsExpander" Header="{loc:Text T91D6882FB172}">
                                                        <StackPanel>
                                                            <Button Content="{loc:Text T6BA6B3414B78}" Click="VJoyConfigurationClick" Style="{StaticResource DeviceToolButton}" Margin="0,8,0,8" />
                                                            <Button Content="{loc:Text T9BAC4ED3CD46}" Click="ControllerTestClick" Style="{StaticResource DeviceToolButton}" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Tag="firmware flash backup restore calibration controller update прошивка калібрування резервна копія" Header="{loc:Text T7F215240E1B3}" x:Name="FirmwareSettingsGroup">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionNote}" Text="{loc:Text TCBE9F53B745D}" />
