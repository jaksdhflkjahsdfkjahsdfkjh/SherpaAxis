<Window x:Class="SherpaAxis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SherpaAxis.App.Localization"
        xmlns:controls="clr-namespace:SherpaAxis.App.Controls"
        xmlns:vm="clr-namespace:SherpaAxis.App.ViewModels"
        Title="{loc:Translate Value={Binding Source={x:Static vm:DashboardViewModel.WindowTitle}}}" Icon="Assets/SherpaAxis.ico" Width="1340" Height="940" MinWidth="1100" MinHeight="760"
        WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#0B1220" Foreground="#E8EFF8"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Closing="WindowClosing" Deactivated="WindowDeactivated">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/ToolTips.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Muted" Color="#95A9C1" />
        <SolidColorBrush x:Key="EditorSurface" Color="#111D2E" />
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Setter Property="Background" Value="#22334C" />
            <Setter Property="Foreground" Value="#E8EFF8" />
            <Setter Property="BorderBrush" Value="#354862" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E8EFF8" /></Trigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{Binding DataContext.IsSwitchingMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                            </MultiDataTrigger.Conditions><Setter TargetName="Surface" Property="Opacity" Value="1"/></MultiDataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#45D6BB" /><Setter Property="Foreground" Value="#092A29" /><Setter Property="BorderBrush" Value="#45D6BB" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1728" /><Setter Property="Foreground" Value="#E8EFF8" />
            <Setter Property="BorderBrush" Value="#34465F" /><Setter Property="CaretBrush" Value="#45D6BB" />
            <Setter Property="Padding" Value="9,7" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#365975" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#78E3C6"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#E8EFF8" /><Setter Property="Padding" Value="10,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Item" Background="#18273C" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Item" Property="Background" Value="#365975"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#304B69" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FocusRing" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border BorderBrush="#78E3C6" BorderThickness="2" CornerRadius="6" Margin="-2"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8EFF8"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="ComboSurface" Background="#18273C" BorderBrush="#34465F" BorderThickness="1" CornerRadius="5"/>
                    <ToggleButton x:Name="DropDownToggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,7,27,7" IsHitTestVisible="False"/>
                    <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="6,3" Margin="2,1,26,1" IsReadOnly="{TemplateBinding IsReadOnly}" ToolTip="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <TextBlock Text="⌄" Foreground="#95A9C1" HorizontalAlignment="Right" Margin="0,4,10,0" IsHitTestVisible="False"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="#536C8B" BorderThickness="1" Background="#18273C">
                            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate></ScrollViewer.Template>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#78E3C6"/><Setter TargetName="ComboSurface" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="#223750"/></Trigger>

                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="controls:StableComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{loc:Translate Value={Binding}}"/></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/><Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="#101C2D"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton x:Name="PageDecrease" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb x:Name="ScrollThumb" MinHeight="24" MinWidth="8" Cursor="Hand">
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Border x:Name="Grip" Background="#48637E" CornerRadius="4" Margin="2"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#679AAB"/></Trigger>
                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#45D6BB"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Grip" Property="Background" Value="#293D57"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton x:Name="PageIncrease" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="12"/><Setter Property="Width" Value="Auto"/>
                        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/><Setter TargetName="ScrollThumb" Property="MinHeight" Value="8"/>
                        <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                        <Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#E8EFF8"/><Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><StackPanel>
                    <ToggleButton Foreground="{TemplateBinding Foreground}" x:Name="HeaderToggle" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HeaderSurface" Background="#18273C" BorderBrush="#304157" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                <DockPanel><TextBlock Text="⌄" DockPanel.Dock="Right" Foreground="#95A9C1"/><ContentPresenter/></DockPanel>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="#78E3C6"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#223750"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                        <ContentPresenter ContentSource="Header"/>
                    </ToggleButton>
                    <ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                </StackPanel></Border>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
        <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" /><Setter Property="Margin" Value="0,22,0,12" /></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4E1EF"/><Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <DockPanel Background="Transparent">
                    <Border x:Name="CheckSurface" Width="16" Height="16" BorderBrush="#536C8B" BorderThickness="1" Background="#0D1728" CornerRadius="3" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Path x:Name="CheckMark" Data="M 2,7 L 5,10 L 11,3" Stroke="#78E3C6" StrokeThickness="2" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </DockPanel>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#78E3C6"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="DashboardRoot" Margin="22,16,22,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="34"/></Grid.RowDefinitions>
        <DockPanel Height="70" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Width="500" HorizontalAlignment="Right">
                <TextBlock Text="{loc:Translate Value={Binding Status}}" Foreground="#78E3C6" FontSize="14" HorizontalAlignment="Right"/>
                <TextBlock Text="{loc:Translate Value={Binding SourceName}}" TextTrimming="CharacterEllipsis" Foreground="#95A9C1" FontSize="11" HorizontalAlignment="Right"/>
                <TextBlock Text="{loc:Translate Value={Binding OutputInfo}}" ToolTip="{loc:Translate Value={Binding OutputInfo}}" Foreground="#DFBC7A" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{loc:Translate Value={Binding Diagnostics.FirmwareNotice}}" ToolTip="{loc:Translate Value={Binding Diagnostics.FirmwareNotice}}" Foreground="#FFCE83" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Text T90CF9229B31F}" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Text T81484AE97371}" FontSize="10" Foreground="#95A9C1"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" TextElement.Foreground="#E8EFF8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="StartupRecoveryPanel" DataContext="{Binding Recovery}" Background="#202334" BorderBrush="#B18445" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <TextBlock Text="{loc:Translate Value={Binding Status}}" FontWeight="SemiBold" Foreground="#FFCE83" TextWrapping="Wrap"/>
                    <controls:StableComboBox x:Name="RecoveryRecordSelector" ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" ItemTemplate="{x:Null}" IsEnabled="{Binding CanCheck}" Margin="0,8,0,0" AutomationProperties.Name="{loc:Text T224FC5C90846}" ToolTip="{loc:Text TD298BD946E57}" AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                        <controls:StableComboBox.Style><Style TargetType="controls:StableComboBox" BasedOn="{StaticResource {x:Type controls:StableComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding Records.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:StableComboBox.Style>
                    </controls:StableComboBox>
                    <TextBlock Text="{loc:Translate Value={Binding Detail}}" Foreground="#E8EFF8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding FilePath}" Foreground="#95A9C1" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="CheckRecoveryButton" Content="{loc:Text TFB7099AD8E81}" Click="CheckRecoveryClick" IsEnabled="{Binding CanCheck}" FontSize="12" Padding="10,7"/>
                        <Button x:Name="RestoreRecoveryButton" Content="{loc:Text T96D536EB0D3A}" Click="RestoreRecoveryClick" IsEnabled="{Binding CanRestore}" FontSize="12" Padding="10,7"/>
                        <Button x:Name="SaveRecoveryButton" Content="{loc:Text T303F8DAA65FC}" Click="SaveRecoveryClick" IsEnabled="{Binding CanSave}" FontSize="12" Padding="10,7">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowSave}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="{loc:Text TAC0BAAF69161}" Click="OpenRecoveryFolderClick" IsEnabled="{Binding CanCheck}" FontSize="12" Padding="10,7"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1">
                <Border x:Name="VendorControlWarning" Background="#202334" BorderBrush="#B18445" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding VendorControlRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{loc:Text TD8080869C6E9}" TextWrapping="Wrap" Foreground="#FFCE83" FontSize="13" AutomationProperties.LiveSetting="Assertive"/>
                </Border>
                <Border x:Name="DraftRecoveryPanel" Background="#202334" BorderBrush="#B18445" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasRecoverableDrafts}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanTune}">
                            <Button Content="{loc:Text TF8B6B337B812}" Click="RestoreDraftsClick" Padding="10,7" FontSize="12"/>
                            <Button x:Name="DiscardDraftsButton" Content="{loc:Text T145545F4C7A6}" Click="DiscardDraftsClick" Padding="10,7" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Text T2577E128A1F8}" TextWrapping="Wrap" Foreground="#FFCE83" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            <Border x:Name="ProfileBar" Grid.Row="1" Background="#111E30" BorderBrush="#24354C" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,12">
                <DockPanel LastChildFill="True" IsEnabled="{Binding CanTune}">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="{loc:Text T5CD5FC61B633}" VerticalAlignment="Center" Foreground="#B4C4D8" Background="Transparent" FontSize="12" Margin="0,0,8,0" ToolTip="{loc:Translate Value={Binding ToolTip, ElementName=AutoLoadProfileCheckBox}}" ToolTipService.InitialShowDelay="300"/>
                        <CheckBox x:Name="AutoLoadProfileCheckBox" IsChecked="{Binding SelectedAutoLoad, Mode=OneWay}" Click="AutoLoadProfileClick" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="{loc:Text T92BBC9769282}" AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}" ToolTip="{loc:Text TDB88E6801A7A}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" Click="SaveLibraryClick" Width="34" Padding="7" Margin="0,0,5,0" AutomationProperties.Name="{loc:Text T0C8209E72EC8}" ToolTip="{loc:Text T48F3E3EAEAE7}"/>
                        <Button x:Name="NewProfileButton" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Click="NewProfileClick" Width="34" Padding="7" Margin="0,0,5,0" AutomationProperties.Name="{loc:Text TFCF4F3F4D5F7}" ToolTip="{loc:Text T5A0E301AD8CC}"/>
                        <Button x:Name="ProfileMoreButton" Content="···" Click="ProfileMenuClick" Width="34" Padding="7" Margin="0" AutomationProperties.Name="{loc:Text TD8C8A6B2F159}" ToolTip="{loc:Text TA19589F9A857}">
                            <Button.ContextMenu><ContextMenu Background="#17273B" Foreground="#E8EFF8" FontFamily="Segoe UI" FontSize="12" BorderBrush="#354862" BorderThickness="1" Padding="4">
                                <ContextMenu.Template><ControlTemplate TargetType="ContextMenu">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                        <ItemsPresenter/>
                                    </Border>
                                </ControlTemplate></ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="#E8EFF8"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#304B69"/></Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#78E3C6"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.45"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                    <Style x:Key="ProfileMenuSeparator" TargetType="Separator">
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                                            <Border Height="1" Margin="4,4" Background="#354862"/>
                                        </ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="{loc:Text TFCF4F3F4D5F7}" Click="NewProfileClick"/>
                                <MenuItem Header="{loc:Text TDDA90D446623}" Click="OpenProfileClick"/>
                                <MenuItem Header="{loc:Text T6EF6A470EC18}" Click="DuplicateProfileClick"/>
                                <MenuItem Header="{loc:Text TD7754C2A4510}" Click="RenameProfileClick"/>
                                <Separator Style="{StaticResource ProfileMenuSeparator}"/>
                                <MenuItem Header="{loc:Text T9088EE671F7A}" Click="SaveProfileClick"/>
                                <Separator Style="{StaticResource ProfileMenuSeparator}"/>
                                <MenuItem Header="{loc:Text TBFF260A6B20D}" Click="UndoDeleteProfileClick" IsEnabled="{Binding PlacementTarget.DataContext.CanUndoDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="{loc:Text T47311AF432A7}" Click="DeleteProfileClick" Foreground="#FF9A9A" ToolTip="{loc:Text TA301450B6392}"/>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <controls:StableComboBox x:Name="ProfileSelector" ItemsSource="{Binding ProfileTabs}" SelectedItem="{Binding SelectedProfile, Mode=OneWay}"
                        IsSynchronizedWithCurrentItem="False" DisplayMemberPath="DisplayName" ItemTemplate="{x:Null}" SelectionChanged="ProfileSelectionChanged" MinWidth="160" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{loc:Text T75192487A033}" AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}" ToolTip="{loc:Text T484973638A1D}"/>
                </DockPanel>
            </Border>
            </StackPanel>
            <Grid Grid.Row="2" x:Name="WorkbenchContent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
