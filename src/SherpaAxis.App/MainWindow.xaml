                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionNote}" Text="{loc:Text TC088BDC0AE2B}" />
                                                <StackPanel x:Name="HelpPanel">
                                                    <Button x:Name="GettingStartedButton" Content="{loc:Text T831D0F72D242}" Click="GettingStartedClick" Style="{StaticResource DeviceToolButton}" ToolTip="{loc:Text T9133A7C768BD}" />
                                                    <Button x:Name="SetupGuideButton" Content="{loc:Text TF91058B1DFBD}" Click="SetupGuideClick" Style="{StaticResource DeviceToolButton}" ToolTip="{loc:Text TC4EF8BC944C0}" />
                                                </StackPanel>
                                                <Button x:Name="ExportDiagnosticsButton" Content="{loc:Text T5F946534EF5C}" Click="ExportDiagnosticsClick" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip="{loc:Text T2140CBD331E9}" />
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Translate Value={Binding Status}}" Foreground="#78E3C6" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
                <GridSplitter Background="#243B50" Width="6" Grid.Column="1" ResizeBehavior="PreviousAndNext" MouseDoubleClick="ResetWorkspaceWidth" ToolTip="{loc:Text T4669439D6B36}" x:Name="WorkspaceSplitter" HorizontalAlignment="Center" ShowsPreview="True" VerticalAlignment="Stretch" ResizeDirection="Columns" />
            </Grid>
        </Grid>
        <Border x:Name="FooterBar" Grid.Row="2" Padding="0,3" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Updates.HasUpdate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Hyperlink x:Name="AppUpdateLink" NavigateUri="{Binding Updates.ReleasePage}" RequestNavigate="AppReleaseNavigate" Foreground="#78E3C6">
                            <Run Text="{loc:Translate Value={Binding Updates.LinkLabel}}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="11">
                        <Hyperlink x:Name="BugReportLink" NavigateUri="{x:Static vm:DashboardViewModel.IssuesUri}" RequestNavigate="ReportBugNavigate" Foreground="#78E3C6" ToolTip="{x:Static vm:DashboardViewModel.IssuesUri}">
                            <Run Text="{loc:Text TF75E0BD8FF23}" />
                        </Hyperlink>
                    </TextBlock>
                    <Border Background="#18273C" BorderBrush="#34465F" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppVersionLabel" Text="{x:Static vm:DashboardViewModel.VersionLabel}" Foreground="#95A9C1" FontSize="11" />
                    </Border>
                </StackPanel>
                <Button x:Name="UndoDeleteProfileButton" DockPanel.Dock="Right" Content="{loc:Text TBFF260A6B20D}" Click="UndoDeleteProfileClick" Padding="10,3" FontSize="11" IsEnabled="{Binding CanTune}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUndoDelete}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{loc:Translate Value={Binding Message}}" ToolTip="{loc:Translate Value={Binding Message}}" Foreground="#95A9C1" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text TCCDE872DAA06}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
        <controls:TourOverlay x:Name="TourLayer" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed" DataContext="{Binding Tour}" NextRequested="TourNextClick" BackRequested="TourBackClick" DismissRequested="TourDismissClick" />
    </Grid>
</Window>
