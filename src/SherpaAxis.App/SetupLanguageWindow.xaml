<Window x:Class="SherpaAxis.App.SetupLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0B1220" Foreground="#E8EFF8" FontFamily="Segoe UI"
        Icon="Assets/SherpaAxis.ico" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources><ResourceDictionary Source="Themes/Setup.xaml"/></Window.Resources>
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="Explanation" Foreground="#B4C4D8" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="EnglishButton" Content="English" Click="EnglishClick" FontSize="15" Padding="16,14"/>
            <Button x:Name="UkrainianButton" Grid.Column="2" Content="Українська" Click="UkrainianClick" FontSize="15" Padding="16,14"/>
        </Grid>
        <TextBlock x:Name="StatusText" Foreground="#FFCE83" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="CancelButton" Click="CancelClick" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
