<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="OverlaySlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="28" /><Setter Property="IsMoveToPointEnabled" Value="True" /><Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" VerticalAlignment="Center" Height="28">
                <Border Height="4" Background="{DynamicResource BorderBrush}" CornerRadius="2" VerticalAlignment="Center" />
                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Width="12" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource AccentForegroundBrush}" CornerRadius="4" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
