<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets/SherpaAxis.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="SherpaAxis.App.Tests" />
    <Resource Include="Assets/SherpaAxis.ico" />
    <Resource Include="Assets/FilterExamples/**/*.png" />
    <EmbeddedResource Include="Localization/uk.json" />
    <EmbeddedResource Include="../../vendor/dfuse/sha256.json" LogicalName="SherpaAxis.App.DfuSeHashes.json" />
    <Content Include="../../firmware/*.dfu" Link="Firmwares/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../installer/Remove-ZipPackage.ps1" Link="Tools/Remove-ZipPackage.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/dfuse/**/*" Link="Tools/DfuSe/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SherpaAxis.Bridge/SherpaAxis.Bridge.csproj" />
    <ProjectReference Include="../SherpaAxis.Profiles/SherpaAxis.Profiles.csproj" />
    <ProjectReference Include="../SherpaAxis.FeelVR/SherpaAxis.FeelVR.csproj" />
  </ItemGroup>
</Project>
