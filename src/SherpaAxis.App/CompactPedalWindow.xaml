<Window x:Class="SherpaAxis.App.CompactPedalWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SherpaAxis.App.Localization" xmlns:controls="clr-namespace:SherpaAxis.App.Controls" xmlns:theme="clr-namespace:SherpaAxis.App.Themes"
        Title="{loc:Text TE4BAE9A5CF3D}" Width="640" Height="140" MinWidth="360" MaxWidth="1000" MinHeight="110" MaxHeight="220" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Dashboard.xaml" /></ResourceDictionary.MergedDictionaries>
            <controls:PedalPercentConverter x:Key="PedalPercent" />
            <Style x:Key="TelemetryMeter" TargetType="ProgressBar">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" Background="{DynamicResource SurfaceBrush}">
                        <Grid.LayoutTransform><RotateTransform Angle="-90" /></Grid.LayoutTransform>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="OverlayResizeGrip" TargetType="Thumb">
                <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
                <EventSetter Event="DragStarted" Handler="BeginResize" /><EventSetter Event="DragDelta" Handler="ResizeOverlay" /><EventSetter Event="DragCompleted" Handler="EndResize" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="OverlaySurface" IsHitTestVisible="{Binding Settings.CanEditPlacement}" MouseLeftButtonDown="MoveOverlay" Cursor="SizeAll">
        <Border x:Name="OverlayShell" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Background><SolidColorBrush Color="{x:Static theme:AppColors.Panel}" Opacity="0.94" /></Border.Background>
        </Border>
        <Border Background="{DynamicResource AccentBrush}" Width="2" HorizontalAlignment="Left" Margin="0,1" />
        <Grid x:Name="CompactRoot" Margin="12,8,12,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
            <TextBlock Text="SHERPAAXIS" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
            </TextBlock>
            <controls:CombinedPedalPlot x:Name="TelemetryPlot" Grid.Column="1" Margin="7,0,8,0" Frame="{Binding GraphFrame}"
                                        WindowSeconds="{Binding Settings.WindowSeconds}" ShowRaw="{Binding Settings.ShowRaw}"
                                        ShowFiltered="{Binding Settings.ShowFiltered}" ShowOutput="{Binding Settings.ShowOutput}" IsHitTestVisible="False"
                                        AutomationProperties.Name="{loc:Text TBB56D24E91CF}" />
            <ItemsControl x:Name="CompactMeters" Grid.Column="2" ItemsSource="{Binding Cards}" Margin="6,0,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="2,0" ToolTip="{loc:Translate Value={Binding Name}}">
                        <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="15" /></Grid.RowDefinitions>
                        <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{Binding Axis, Converter={StaticResource PedalBrush}, ConverterParameter=Telemetry}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding OutputPercent, Converter={StaticResource PedalPercent}}" /><Style.Triggers>
                                <DataTrigger Binding="{Binding IsFresh}" Value="False"><Setter Property="Text" Value="—" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Grid.Row="1" Style="{StaticResource TelemetryMeter}" Orientation="Vertical" Width="15" Margin="0,3,0,3" Maximum="100"
                                     Value="{Binding OutputPercent, Mode=OneWay}" Foreground="{Binding Axis, Converter={StaticResource PedalBrush}, ConverterParameter=Telemetry}"
                                     AutomationProperties.Name="{loc:Translate Value={Binding Name}}" />
                        <TextBlock Grid.Row="2" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                <DataTrigger Binding="{Binding Name}" Value="CLUTCH"><Setter Property="Text" Value="C" /></DataTrigger>
                                <DataTrigger Binding="{Binding Name}" Value="BRAKE"><Setter Property="Text" Value="B" /></DataTrigger>
                                <DataTrigger Binding="{Binding Name}" Value="THROTTLE"><Setter Property="Text" Value="T" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="OverlayNotice" Grid.Column="1" Foreground="{DynamicResource CautionBrush}" Background="{DynamicResource PanelBrush}" FontSize="10"
                       VerticalAlignment="Top" HorizontalAlignment="Right" Margin="7,0,8,0" Padding="4,2" TextWrapping="Wrap" MaxWidth="180">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Translate Value={Binding Status}}" /><Style.Triggers>
                    <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsLive}" Value="True" /><Condition Binding="{Binding Settings.GraphPaused}" Value="True" /></MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" /><Setter Property="Text" Value="{loc:Text TA781C22A0D89}" />
                    </MultiDataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <Path Data="M 0,8 L 8,0 M 4,8 L 8,4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" Opacity="0.45"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" IsHitTestVisible="False">
            <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding Settings.IsLocked}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style>
        </Path>
        <Thumb x:Name="ResizeLeft" Style="{StaticResource OverlayResizeGrip}" Width="6" HorizontalAlignment="Left" Margin="0,10" Cursor="SizeWE" />
        <Thumb x:Name="ResizeRight" Style="{StaticResource OverlayResizeGrip}" Width="6" HorizontalAlignment="Right" Margin="0,10" Cursor="SizeWE" />
        <Thumb x:Name="ResizeTop" Style="{StaticResource OverlayResizeGrip}" Height="6" VerticalAlignment="Top" Margin="10,0" Cursor="SizeNS" />
        <Thumb x:Name="ResizeBottom" Style="{StaticResource OverlayResizeGrip}" Height="6" VerticalAlignment="Bottom" Margin="10,0" Cursor="SizeNS" />
        <Thumb x:Name="ResizeTopLeft" Style="{StaticResource OverlayResizeGrip}" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
        <Thumb x:Name="ResizeTopRight" Style="{StaticResource OverlayResizeGrip}" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
        <Thumb x:Name="ResizeBottomLeft" Style="{StaticResource OverlayResizeGrip}" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
        <Thumb x:Name="ResizeBottomRight" Style="{StaticResource OverlayResizeGrip}" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
    </Grid>
</Window>
