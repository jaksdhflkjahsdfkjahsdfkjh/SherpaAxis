<Window x:Class="SherpaAxis.App.FirmwareUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SherpaAxis.App.Localization"
        xmlns:controls="clr-namespace:SherpaAxis.App.Controls"
        Title="{loc:Text T2D59B6CF3962}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#0B1220" Foreground="#E8EFF8" FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="{loc:Text TC2A314C3B32B}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <controls:StableComboBox x:Name="FirmwareSelector" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" DisplayMemberPath="DisplayName" ItemTemplate="{x:Null}" IsEnabled="{Binding CanPrepare}" Margin="0,0,0,14" AutomationProperties.Name="{loc:Text TC2A314C3B32B}"/>
        <TextBlock Text="{loc:Text T0F83D7DCBABE}" TextWrapping="Wrap" Foreground="#95A9C1" Margin="0,0,0,14"/>
        <TextBlock Text="{loc:Translate Value={Binding Status}}" TextWrapping="Wrap" Foreground="#FFCE83" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="FlashFirmwareButton" Content="{loc:Translate Value={Binding FlashLabel}}" Click="FlashClick" IsEnabled="{Binding CanFlash}" HorizontalAlignment="Right" MinWidth="110"/>
    </StackPanel>
</Window>
