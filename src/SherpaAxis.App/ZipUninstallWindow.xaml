<Window x:Class="SherpaAxis.App.ZipUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0B1220" Foreground="#E8EFF8" FontFamily="Segoe UI"
        Icon="Assets/SherpaAxis.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources><ResourceDictionary Source="Themes/Setup.xaml"/></Window.Resources>
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock x:Name="Explanation" Foreground="#B4C4D8" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <CheckBox x:Name="RemoveDrivers" Foreground="#E8EFF8" Margin="0,0,0,8"><TextBlock x:Name="DriverOption" TextWrapping="Wrap"/></CheckBox>
        <TextBlock x:Name="OwnedDrivers" Foreground="#95A9C1" TextWrapping="Wrap" Margin="24,0,0,14"/>
        <CheckBox x:Name="RemoveSavedData" Foreground="#E8EFF8" Margin="0,0,0,8"><TextBlock x:Name="DataOption" TextWrapping="Wrap"/></CheckBox>
        <TextBlock x:Name="DataWarning" Foreground="#FFCE83" TextWrapping="Wrap" Margin="24,0,0,16"/>
        <TextBlock x:Name="StatusText" Foreground="#FFCE83" TextWrapping="Wrap" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="LogsButton" Click="LogsClick" HorizontalAlignment="Left"/>
            <Button x:Name="RemoveButton" Grid.Column="1" Click="RemoveClick"/>
            <Button x:Name="CloseButton" Grid.Column="3" Click="CloseClick"/>
        </Grid>
    </StackPanel>
</Window>
